}

Table incident.investigations {
  id uuid [pk]
  tenant_id uuid [not null]
  incident_id uuid [not null]
  lead_investigator_member_id uuid [not null]
  method varchar(80)
  summary text
  status varchar(30) [not null]
  started_at timestamptz
  completed_at timestamptz
}

Table incident.investigation_team {
  id uuid [pk]
  tenant_id uuid [not null]
  investigation_id uuid [not null]
  tenant_member_id uuid [not null]
  team_role varchar(80)
}

Table incident.root_causes {
  id uuid [pk]
  tenant_id uuid [not null]
  investigation_id uuid [not null]
  cause_type varchar(30) [not null]
  category_id uuid
  description text [not null]
  evidence_summary text
}

Table incident.classification_reviews {
  id uuid [pk]
  tenant_id uuid [not null]
  incident_id uuid [not null]
  reviewer_member_id uuid [not null]
  classification_json jsonb [not null]
  decision varchar(30) [not null]
  reviewed_at timestamptz [not null]
}


// ============================================================
// CAPA
// ============================================================

Table capa.actions {
  id uuid [pk]
  tenant_id uuid [not null]
  record_id uuid [not null, unique]
  action_type varchar(20) [not null]
  description text [not null]
  owner_member_id uuid [not null]
  priority varchar(20) [not null]
  due_date date [not null]
  progress_percentage smallint [not null]
  verification_required boolean [not null]
}

Table capa.sources {
  id uuid [pk]
  tenant_id uuid [not null]
  action_id uuid [not null]
  source_record_id uuid [not null]
